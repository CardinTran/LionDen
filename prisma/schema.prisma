generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model UserProfile {
  id               String    @id @default(cuid())
  guildId          String
  userId           String
  displayName      String
  xp               Int       @default(0)
  level            Int       @default(1)
  coins            Int       @default(0)
  lastMessageXpAt  DateTime?
  lastDailyClaimAt DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([guildId, userId])
}

model RedEnvelope {
  id                   String            @id @default(cuid())
  guildId              String
  channelId            String
  createdByUserId      String
  createdByDisplayName String
  amount               Int
  status               RedEnvelopeStatus @default(OPEN)
  messageId            String?
  claimedByUserId      String?
  claimedByDisplayName String?
  claimedAt            DateTime?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  @@index([guildId, status])
}

model RedEnvelopeDropConfig {
  id                 String    @id @default(cuid())
  guildId            String    @unique
  channelId          String
  enabled            Boolean   @default(true)
  minAmount          Int       @default(10)
  maxAmount          Int       @default(50)
  minIntervalMinutes Int       @default(60)
  maxIntervalMinutes Int       @default(180)
  nextDropAt         DateTime?
  lastDroppedAt      DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model LionSpecies {
  id                 String            @id @default(cuid())
  publicId           String            @unique
  slug               String            @unique
  name               String
  imagePath          String
  rarity             LionRarity        @default(COMMON)
  baseCatchRate      Int               @default(60)
  baseValue          Int               @default(1)
  spawnWeight        Int               @default(100)
  primaryType        LionElement       @default(NEUTRAL)
  secondaryType      LionElement?
  baseHp             Int               @default(50)
  baseAttack         Int               @default(10)
  baseDefense        Int               @default(10)
  baseSpeed          Int               @default(10)
  abilityKey         String            @default("steady-heart")
  abilityName        String            @default("Steady Heart")
  abilityDescription String            @default("No special battle effect yet.")
  description        String            @default("")
  isEnabled          Boolean           @default(true)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  ownedLions         UserLion[]
  activeSpawns       ActiveLionSpawn[]

  @@index([publicId])
  @@index([rarity, isEnabled])
}

model UserLion {
  id                String             @id @default(cuid())
  guildId           String
  userId            String
  ownerDisplayName  String             @default("")
  lionSpeciesId     String
  nickname          String?
  level             Int                @default(1)
  experience        Int                @default(0)
  sourceType        String
  sourceReferenceId String?
  lastTrainedAt     DateTime?
  lastBattledAt     DateTime?
  acquiredAt        DateTime           @default(now())
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  species           LionSpecies        @relation(fields: [lionSpeciesId], references: [id])
  teamSlots         UserLionTeamSlot[]

  @@index([guildId, userId])
  @@index([guildId, level])
  @@index([lionSpeciesId])
}

model UserLionTeamSlot {
  id         String   @id @default(cuid())
  guildId    String
  userId     String
  slot       Int
  userLionId String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  lion       UserLion @relation(fields: [userLionId], references: [id], onDelete: Cascade)

  @@unique([guildId, userId, slot])
  @@unique([guildId, userId, userLionId])
  @@index([guildId, userId])
  @@index([userLionId])
}

model ActiveLionSpawn {
  id                  String          @id @default(cuid())
  guildId             String
  channelId           String
  lionSpeciesId       String
  level               Int             @default(1)
  messageId           String?
  status              LionSpawnStatus @default(ACTIVE)
  spawnedAt           DateTime        @default(now())
  expiresAt           DateTime
  caughtByUserId      String?
  caughtByDisplayName String?
  caughtAt            DateTime?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  species             LionSpecies     @relation(fields: [lionSpeciesId], references: [id])

  @@index([guildId, status])
  @@index([guildId, channelId, status])
}

model BotGuildConfig {
  id                 String   @id @default(cuid())
  guildId            String   @unique
  maintenanceMode    Boolean  @default(false)
  maintenanceMessage String   @default("LionDen is in maintenance mode. Please try again later.")
  updatedByUserId    String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model LionShopItemDefinition {
  id          String             @id @default(cuid())
  itemKey     String             @unique
  name        String
  category    LionItemCategory
  priceCoins  Int
  effectType  LionItemEffectType
  effectValue Int
  description String             @default("")
  isEnabled   Boolean            @default(true)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
}

model UserItemInventory {
  id        String   @id @default(cuid())
  guildId   String
  userId    String
  itemKey   String
  quantity  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([guildId, userId, itemKey])
  @@index([guildId, userId])
}

model LionSpawnConfig {
  id                 String    @id @default(cuid())
  guildId            String    @unique
  enabled            Boolean   @default(true)
  minIntervalMinutes Int       @default(120)
  maxIntervalMinutes Int       @default(240)
  nextSpawnAt        DateTime?
  lastSpawnedAt      DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model LionChannelEffect {
  id                String             @id @default(cuid())
  guildId           String
  channelId         String
  itemKey           String
  effectType        LionItemEffectType
  effectValue       Int
  activatedByUserId String
  activatedAt       DateTime           @default(now())
  expiresAt         DateTime
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([guildId, channelId])
  @@index([guildId, channelId, effectType])
  @@index([guildId, expiresAt])
}

model LionBattleRecord {
  id                    String   @id @default(cuid())
  guildId               String
  challengerUserId      String
  challengerDisplayName String
  opponentUserId        String
  opponentDisplayName   String
  winnerUserId          String
  winnerDisplayName     String
  loserUserId           String
  loserDisplayName      String
  winnerSide            String
  challengerTeamLionIds String
  opponentTeamLionIds   String
  participantLionIds    String
  mvpLionId             String?
  mvpLionName           String?
  roundsCount           Int      @default(0)
  createdAt             DateTime @default(now())

  @@index([guildId, createdAt])
  @@index([guildId, challengerUserId, createdAt])
  @@index([guildId, opponentUserId, createdAt])
  @@index([guildId, winnerUserId, createdAt])
}

model LionBattleChallenge {
  id                     String    @id @default(cuid())
  guildId                String
  channelId              String
  challengerUserId       String
  challengerDisplayName  String
  opponentUserId         String
  opponentDisplayName    String
  status                 String    @default("PENDING")
  expiresAt              DateTime
  acceptedAt             DateTime?
  declinedAt             DateTime?
  resolvedBattleRecordId String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@index([guildId, channelId, status, expiresAt])
  @@index([guildId, challengerUserId, status, expiresAt])
  @@index([guildId, opponentUserId, status, expiresAt])
}

model WeeklyChallengeDefinition {
  id           String                      @id @default(cuid())
  challengeKey String                      @unique
  title        String
  description  String
  activityType WeeklyChallengeActivityType
  targetCount  Int
  rewardXp     Int                         @default(0)
  rewardCoins  Int                         @default(0)
  isEnabled    Boolean                     @default(true)
  createdAt    DateTime                    @default(now())
  updatedAt    DateTime                    @updatedAt
}

model UserWeeklyChallengeProgress {
  id            String    @id @default(cuid())
  guildId       String
  userId        String
  challengeKey  String
  weekKey       String
  progressCount Int       @default(0)
  completedAt   DateTime?
  rewardedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([guildId, userId, challengeKey, weekKey])
  @@index([guildId, userId, weekKey])
  @@index([guildId, weekKey])
}

model BadgeDefinition {
  id          String   @id @default(cuid())
  badgeKey    String   @unique
  title       String
  description String
  isEnabled   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model UserBadge {
  id        String   @id @default(cuid())
  guildId   String
  userId    String
  badgeKey  String
  awardedAt DateTime @default(now())

  @@unique([guildId, userId, badgeKey])
  @@index([guildId, userId])
}

model House {
  id          String             @id @default(cuid())
  guildId     String
  houseKey    String
  name        String
  description String?
  emoji       String?
  color       String?
  isActive    Boolean            @default(true)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  memberships HouseMembership[]
  pointLedger HousePointLedger[]

  @@unique([guildId, houseKey])
  @@index([guildId])
}

model HouseMembership {
  id        String   @id @default(cuid())
  guildId   String
  houseId   String
  userId    String
  joinedAt  DateTime @default(now())
  updatedAt DateTime @updatedAt
  house     House    @relation(fields: [houseId], references: [id])

  @@unique([guildId, userId])
  @@index([guildId, houseId])
}

model HousePointLedger {
  id         String               @id @default(cuid())
  guildId    String
  houseId    String
  userId     String?
  sourceType HousePointSourceType
  sourceId   String?
  points     Int
  reason     String
  createdAt  DateTime             @default(now())
  house      House                @relation(fields: [houseId], references: [id])

  @@unique([guildId, sourceType, sourceId])
  @@index([guildId, houseId, createdAt])
  @@index([guildId, userId, createdAt])
  @@index([guildId, sourceType, createdAt])
}

model HouseRecapConfig {
  id        String   @id @default(cuid())
  guildId   String   @unique
  channelId String?
  isEnabled Boolean  @default(false)
  weekday   Int      @default(0)
  hour      Int      @default(18)
  minute    Int      @default(0)
  timezone  String   @default("America/Chicago")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model HouseRecapPost {
  id        String   @id @default(cuid())
  guildId   String
  weekKey   String
  channelId String
  messageId String?
  postedAt  DateTime @default(now())

  @@unique([guildId, weekKey])
  @@index([guildId, postedAt])
}

model PracticeSession {
  id                    String                @id @default(cuid())
  guildId               String
  startedByUserId       String
  startedByDisplayName  String
  announcementChannelId String
  source                PracticeSessionSource @default(MANUAL)
  scheduledDateKey      String?
  scheduledStartAt      DateTime?
  scheduledEndAt        DateTime?
  announcementMessageId String?
  rsvpMessageId         String?
  rsvpPostedAt          DateTime?
  attendanceMessageId   String?
  attendancePostedAt    DateTime?
  status                PracticeSessionStatus @default(ACTIVE)
  startedAt             DateTime              @default(now())
  endedAt               DateTime?
  endedByUserId         String?
  checkIns              PracticeCheckIn[]

  @@unique([guildId, source, scheduledDateKey])
  @@index([guildId, status])
}

model PracticeCheckIn {
  id               String                    @id @default(cuid())
  sessionId        String
  guildId          String
  userId           String
  displayName      String
  rsvpStatus       PracticeRsvpStatus?
  attendanceStatus PracticeAttendanceStatus?
  rewardAppliedAt  DateTime?
  rewardXp         Int                       @default(0)
  checkedInAt      DateTime                  @default(now())
  updatedAt        DateTime                  @default(now()) @updatedAt
  session          PracticeSession           @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, userId])
  @@index([guildId, sessionId])
}

enum PracticeSessionStatus {
  SCHEDULED
  ACTIVE
  ENDED
}

model PracticeSchedule {
  id        String   @id @default(cuid())
  guildId   String   @unique
  channelId String?
  timezone  String   @default("America/Chicago")
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum PracticeSessionSource {
  MANUAL
  SCHEDULED
}

enum PracticeRsvpStatus {
  GOING
  LATE
  LEAVING_EARLY
  NOT_GOING
}

enum PracticeAttendanceStatus {
  HERE
  NOT_HERE
}

enum RedEnvelopeStatus {
  OPEN
  CLAIMED
}

enum LionRarity {
  COMMON
  UNCOMMON
  RARE
  EPIC
  LEGENDARY
}

enum LionElement {
  NEUTRAL
  FIRE
  WATER
  EARTH
  WIND
  LIGHT
  SHADOW
  METAL
  NATURE
}

enum LionItemEffectType {
  CATCH_MODIFIER
  SPAWN_BOOST
  RARITY_BOOST
  TYPE_ATTRACTOR
  LEVEL_BOOST
  TRAINING_XP
}

enum LionSpawnStatus {
  ACTIVE
  CAUGHT
  EXPIRED
}

enum LionItemCategory {
  BALL
  SPAWN_MODIFIER
  UTILITY
}

enum WeeklyChallengeActivityType {
  PRACTICE_ATTENDANCE
  LION_CATCH
  LION_TRAIN
  RED_ENVELOPE_CLAIM
  TRAINING_HALL_BATTLE
}

enum HousePointSourceType {
  PRACTICE_ATTENDANCE
  WEEKLY_CHALLENGE
  RED_ENVELOPE_CLAIM
  LION_CATCH
  LION_TRAINING
  TRAINING_BATTLE
  DUEL_COMPLETION
  MESSAGE_ACTIVITY
  ADMIN_ADJUSTMENT
}
